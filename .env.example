# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Твой Telegram id (узнать у @userinfobot). Несколько — через запятую. Доступ к /stats, /leads, /reload
ADMIN_IDS=
# Куда слать заявки (id менеджера или группы). Пусто — первому из ADMIN_IDS
LEADS_CHAT_ID=

# --- Нейросеть (любой OpenAI-совместимый API). Пусто — демо-режим без нейросети ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Модель эмбеддингов для смыслового поиска (например text-embedding-3-small). Пусто — только поиск по словам
EMBEDDING_MODEL=

# --- Бизнес ---
COMPANY_NAME=CozyHome
KNOWLEDGE_DIR=knowledge
DB_PATH=data/bot.db
